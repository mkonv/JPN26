{
  "name": "japan-2026-github-pages",
  "version": "0.4.0",
  "private": true,
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-pwa-assets.mjs",
    "start": "python3 -m http.server 4173 --directory out",
    "test": "node --test tests/*.test.mjs",
    "test:offline": "node tests/offline-pwa.mjs",
    "check": "npm run lint && npm run build && npm test",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "pdf": "python3 scripts/generate_mobile_pdf.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Япония 2026 — маршрут в кармане"
}
